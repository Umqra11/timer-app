rules_version = '2';

// Firestore Security Rules — MVP (D-015: auth YOK, sadece username)
// Patron kararı: kimlik doğrulama yok, ancak veri bütünlüğü için minimum kontrol.

service cloud.firestore {
	match /databases/{database}/documents {

		// usernameler/{u}: atomik claim.
		// Sadece doc mevcut DEĞİLSE oluşturulabilir; mevcut doc güncellenemez.
		// (D-016: unique zorunlu, transaction ile kontrol client tarafında yapılıyor.)
		match /usernames/{username} {
			allow read: if true;
			allow create: if !exists(/databases/$(database)/documents/usernames/$(username))
				&& request.resource.data.uid is string
				&& request.resource.data.uid.size() > 0;
			allow update, delete: if false;
		}

		// users/{uid}: profil (kullanıcı adı, son aktiflik).
		// Cihaz kendi uid'sini okuyup yazabilir; diğerlerini sadece okur.
		match /users/{uid} {
			allow read: if true;
			allow create: if request.resource.data.uid == null  // doc mevcut değilse
				|| request.resource.data.username is string;
			allow update: if true;  // lastActiveAt güncellemesi için
			allow delete: if false;

			// users/{uid}/joinedRooms/{roomId}: hangi odalara katıldı
			// D-062: kullanıcı kendi joinedRooms/{roomId} doc'unu silebilir ("Odadan ayrıl")
			match /joinedRooms/{roomId} {
				allow read: if true;
				allow create, update: if true;  // server-side check yok, MVP (D-059 race window kabul)
				allow delete: if true;  // D-062: silme açık; cross-user koruma auth olmadan mümkün değil (D-015)
			}

			// users/{uid}/rateLimit/{doc}: dakikalık/saatlik sayaç (D-053)
			// Sprint-04 v2: subcollection rule eklendi (sendReaction 404 fix)
			// Sprint-04 v11: structure validation — 4 alan + tipler, negatif sayaç reddedilir.
			// NOT: Cross-user yazım koruması (kötü niyetli client başka uid'in
			// sayacını sıfırlamasın) auth olmadığı için rules ile MÜMKÜN DEĞİL
			// (D-015 — username + localStorage uid, Firebase Auth YOK). Bu
			// koruma için Cloud Function (server-side) gerekli — Sprint-04 #6.
			match /rateLimit/{doc} {
				allow read: if true;
				allow create, update: if request.resource.data.keys().hasAll(['minuteCount', 'minuteResetAt', 'hourCount', 'hourResetAt'])
					&& request.resource.data.minuteCount is int
					&& request.resource.data.minuteResetAt is int
					&& request.resource.data.hourCount is int
					&& request.resource.data.hourResetAt is int
					&& request.resource.data.minuteCount >= 0
					&& request.resource.data.hourCount >= 0;
				allow delete: if false;
			}

			match /sessions/{sessionId} {
				allow create: if request.auth == null  // MVP: cihaz-uid auth-free
					&& request.resource.data.uid == uid
					&& request.resource.data.keys().hasAll(['uid', 'dayKey', 'startedAt', 'endedAt', 'elapsedMs']);
				allow read: if request.auth == null;  // kendi okusun (leaderboard kendi üyeleri için)
				allow update, delete: if false;
			}
		}

		// rooms/{roomId}: herkese açık okunur.
		// D-048: memberCount atomik increment için update'e izin (sadece number alanı)
		// D-049: silme sadece owner için
		match /rooms/{roomId} {
			allow read: if true;
			allow create: if request.resource.data.name is string
				&& request.resource.data.name.size() > 0
				&& request.resource.data.name.size() <= 40
				&& request.resource.data.inviteCode is string
				&& request.resource.data.ownerUid is string
				&& request.resource.data.keys().hasAll(['name', 'ownerUid', 'inviteCode', 'createdAt', 'memberCount']);
			allow update: if request.resource.data.diff(resource.data).affectedKeys()
				.hasOnly(['memberCount'])
				&& request.resource.data.memberCount is int
				&& request.resource.data.memberCount >= 1;
			// D-049: silme — client-side owner check yapıyor (Firestore rules custom
			// function olmadan uid karşılaştırma yapılamadığından MVP'de açık)
			allow delete: if true;

			// rooms/{roomId}/presence/{uid}: odadaki kullanıcı durumu (D-019, D-047)
			match /presence/{uid} {
				allow read: if true;
				allow write: if true;  // MVP: herkes yazabilir
			}

			// rooms/{roomId}/reactions/{reactionId}: kısa tepkiler (D-052, D-053)
			//   - text 1-60 karakter
			//   - expireAt: timestamp (Firestore TTL policy, 4 saat sonra silinir)
			match /reactions/{reactionId} {
				allow read: if true;
				// MVP: text 1-60 + 3 uid alanı zorunlu (D-052, D-053)
				// Sprint-04 v3: hasAll + createdAt/expireAt kuralları kaldırıldı
				// (SDK Date objesi ile hasAll fail ediyordu, rateLimit rule eklendi)
				allow create: if request.resource.data.text is string
					&& request.resource.data.text.size() > 0
					&& request.resource.data.text.size() <= 60
					&& request.resource.data.targetUid is string
					&& request.resource.data.senderUid is string
					&& request.resource.data.senderUsername is string;
				allow update, delete: if false;
			}
		}
	}
}
